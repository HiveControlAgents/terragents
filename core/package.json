{
  "name": "terragents-core",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "TerrAgents Core: a team of autonomous Claude agents working on a real git repo, shown as a city in the browser or in Terraria (fork of the AgentCraft Foreman).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --import tsx src/main.ts",
    "demo": "node --import tsx src/main.ts --backend sim --reset --autostart --auto-answer --speed 0.5",
    "tui": "node --import tsx scripts/fake-mod.ts",
    "answer": "node --import tsx scripts/answer.ts",
    "send": "node --import tsx scripts/send.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "gen:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts",
    "check:protocol-doc": "node --import tsx scripts/gen-protocol-doc.ts --check",
    "check": "tsc --noEmit && vitest run && node --import tsx scripts/gen-protocol-doc.ts --check"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.286",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
